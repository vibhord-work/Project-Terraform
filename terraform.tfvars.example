# Copy to terraform.tfvars and adjust for your target environment.
# Do not commit terraform.tfvars or place secrets in this file.

aws_region   = "us-east-1"
project_name = "project"
environment  = "poc"

vpc_cidr = "10.20.0.0/16"

public_subnet_cidrs = [
  "10.20.1.0/24",
  "10.20.2.0/24"
]

private_subnet_cidrs = [
  "10.20.11.0/24",
  "10.20.12.0/24"
]

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

enable_nat_gateway = true
single_nat_gateway = true
