# Copy to terraform.tfvars and adjust for the target environment.
# Do not commit terraform.tfvars or place secrets in this file.

aws_region   = "us-east-1"
project_name = "project"
environment  = "poc"

vpc_cidr = "10.20.0.0/16"

public_subnet_cidrs = [
  "10.20.1.0/24",
  "10.20.2.0/24"
]

private_subnet_cidrs = [
  "10.20.11.0/24",
  "10.20.12.0/24"
]

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

# Keep the current NAT Gateway during the first NAT-instance deployment.
enable_nat_gateway = true
single_nat_gateway = true

# Stage 1: enable the instance and apply while route flag remains false.
# Stage 2: after testing, set the route flag true and apply.
# Stage 3: after another successful test, disable the NAT Gateway.
enable_nat_instance = false
nat_instance_type = "t3.micro"
route_private_traffic_through_nat_instance = false
